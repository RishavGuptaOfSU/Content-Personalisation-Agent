# ============================================================================
# Root .env — consumed by docker-compose.yml
# Copy to .env before running `docker compose up`.
# See backend/.env.example for the full backend reference.
# ============================================================================

# ------------------------------------------------------------------ postgres
POSTGRES_USER=cpa
POSTGRES_PASSWORD=cpa
POSTGRES_DB=content_personalization
POSTGRES_PORT=5432

# ------------------------------------------------------------------- backend
BACKEND_PORT=8000
# Inside compose the DB host is the service name "postgres".
DATABASE_URL=postgresql+psycopg://cpa:cpa@postgres:5432/content_personalization
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=10080
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# ============================================================================
# LLM PROVIDER: ollama | openai | bedrock | mock
# ============================================================================
LLM_PROVIDER=ollama
LLM_MAX_TOKENS=700

# ---- Ollama -----------------------------------------------------------------
# Start the optional bundled Ollama container:
#     docker compose --profile ollama up -d ollama
#     docker compose exec ollama ollama pull llama3.2:3b
#     docker compose exec ollama ollama pull nomic-embed-text
# …and keep OLLAMA_BASE_URL=http://ollama:11434 below.
#
# To use an Ollama already running on the HOST instead, set:
#     OLLAMA_BASE_URL=http://host.docker.internal:11434
# (on Linux also add `extra_hosts: ["host.docker.internal:host-gateway"]`,
#  which docker-compose.yml already declares for the backend service)
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_ROUTER_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_KEEP_ALIVE=30m
OLLAMA_TIMEOUT=600

# ---- OpenAI-compatible (OpenAI, Groq, Together, OpenRouter, LM Studio) ------
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- AWS Bedrock ------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_ROUTER_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ============================================================================
# EMBEDDINGS — must match the model's native width. Changing this invalidates
# stored vectors: run `python scripts/reembed_memories.py` afterwards.
# ============================================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIM=768
MEMORY_MIN_SIMILARITY=0.45

# ============================================================================
# IMAGE & CHART GENERATION
# Four agents return a rendered PNG instead of prose (post-image, ad-creative,
# poster-image, chart-builder). "local" needs no GPU and no API key; "openai"
# routes the same JSON spec to gpt-image-1 for photographic output.
# Charts are always matplotlib — they must plot the user's real numbers.
# ============================================================================
IMAGE_PROVIDER=local
MEDIA_ROOT=generated_media
MEDIA_MAX_FILES=400

# ------------------------------------------------------------------ frontend
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8000/api
