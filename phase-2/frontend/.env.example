# Frontend configuration (Vite). Only VITE_* variables reach the browser.
# Never put AWS credentials or any secret here — the browser can read all of it.
#
# Phase 2 deliberately uses different ports from phase-1 (8000/5173) so both
# can run at the same time.
#
# Point this at the backend, or use `/api` to go through the Vite dev proxy
# below instead, which avoids CORS entirely.
VITE_API_BASE_URL=http://localhost:8010/api
VITE_APP_NAME="Marketing Agents"

# Dev-server only (not exposed to the browser).
FRONTEND_PORT=5174
BACKEND_ORIGIN=http://localhost:8010
