# ============================================================================
# Content Personalization Agent — backend configuration
# Copy to .env and edit.  NEVER commit the real .env file.
# ============================================================================

# ---------------------------------------------------------------------- app
APP_NAME="Content Personalization Agent"
APP_ENV=development          # development | staging | production
DEBUG=true
API_PREFIX=/api
HOST=0.0.0.0
PORT=8000

# ----------------------------------------------------------------- database
# PRIMARY TARGET — PostgreSQL 16 + pgvector (started by docker-compose):
DATABASE_URL=postgresql+psycopg://cpa:cpa@localhost:5432/content_personalization
#
# Offline fallback for local development without Docker/PostgreSQL.
# Everything works; the vector search runs in Python instead of pgvector.
# DATABASE_URL=sqlite:///./content_personalization.db
#
SQL_ECHO=false
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ----------------------------------------------------------------- security
# REQUIRED IN PRODUCTION: generate with `openssl rand -hex 48`
JWT_SECRET_KEY=change-me-in-production-please-use-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080     # 7 days
BCRYPT_ROUNDS=12

# --------------------------------------------------------------------- cors
# Comma separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# ============================================================================
# LLM PROVIDER — pick ONE. Switching is an env change, never a code change.
#   ollama  : local models, no API key, no cloud          <- recommended default
#   openai  : any OpenAI-compatible API (OpenAI, Groq, Together, LM Studio, vLLM)
#   bedrock : AWS Bedrock
#   mock    : deterministic local composer; runs with no model installed
# ============================================================================
LLM_PROVIDER=ollama
LLM_TEMPERATURE=0.4
# Cap the reply length. Local CPU models generate ~3-10 tokens/sec, so keep this
# modest (600-900) unless you have a GPU. Cloud providers can use 1600+.
LLM_MAX_TOKENS=700
ROUTER_TEMPERATURE=0.0
ROUTER_MAX_TOKENS=256

# ------------------------------------------------------------- 1) OLLAMA ---
# Install: https://ollama.com/download    Then: ollama serve
#   ollama pull llama3.2:3b          # good balance on CPU (2 GB)
#   ollama pull nomic-embed-text     # real embeddings for memory (274 MB)
#
# Model guidance for a CPU-only machine:
#   llama3.2:1b     fastest, weakest reasoning        (~1.3 GB)
#   llama3.2:3b     best speed/quality trade-off      (~2.0 GB)  <- default
#   qwen2.5:3b      strong at structure and JSON      (~1.9 GB)
#   gemma2:2b       very fast, decent prose           (~1.6 GB)
#   mistral:7b      better quality, needs a GPU       (~4.1 GB)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
# A small model is enough for routing; point it at the same model to save RAM.
OLLAMA_ROUTER_MODEL=llama3.2:3b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
# Must exceed the slowest expected reply. CPU generation is slow.
OLLAMA_TIMEOUT=600
OLLAMA_NUM_CTX=8192
# Keeps the model in RAM between requests (avoids a ~20s reload each time).
OLLAMA_KEEP_ALIVE=30m

# --------------------------------------------- 2) OPENAI-COMPATIBLE API ---
# Works with OpenAI and every API that mirrors it:
#   OpenAI      https://api.openai.com/v1          gpt-4o-mini
#   Groq        https://api.groq.com/openai/v1     llama-3.3-70b-versatile   (very fast)
#   Together    https://api.together.xyz/v1        meta-llama/Llama-3.3-70B-Instruct-Turbo
#   OpenRouter  https://openrouter.ai/api/v1       anthropic/claude-3.5-sonnet
#   LM Studio   http://localhost:1234/v1           (local, no key needed)
#   vLLM        http://localhost:8001/v1           (local, no key needed)
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_ROUTER_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT=180

# --------------------------------------------------- 3) AWS BEDROCK ------
# Only read by the backend. These are NEVER sent to the frontend.
# Leave the keys blank to use the default boto3 chain (shared config, SSO,
# instance role, task role…).
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_ROUTER_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0

# ============================================================================
# IMAGE & CHART GENERATION
# Four agents return a FILE instead of prose:
#   marketing.post-image · marketing.ad-creative · creative.poster-image  (image)
#   analytics.chart-builder                                              (chart)
#
# The language model never draws anything — it returns a short JSON spec and a
# renderer produces the PNG. That keeps the renderer swappable and makes it
# impossible for a chart to contain invented numbers.
#
#   local  : Pillow card renderer — typographic cards in your brand colours.
#            No GPU, no API key, ~0.2s per image.            <- default
#   openai : gpt-image-1 — photographic output. Needs OPENAI_API_KEY above.
#
# Charts are ALWAYS matplotlib: a chart must plot the user's real data, so there
# is nothing for an image model to do.
# ============================================================================
IMAGE_PROVIDER=local
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_TIMEOUT=180

# Where rendered files are written (relative paths resolve against backend/).
# Served by GET /api/media/{filename}, which is deliberately unauthenticated so
# <img src> works in the browser; filenames carry a random component.
MEDIA_ROOT=generated_media
# Retention cap. The oldest files beyond this are pruned after each render.
MEDIA_MAX_FILES=400

# ============================================================================
# EMBEDDINGS (semantic memory)
#   ollama : nomic-embed-text, 768 dims   <- recommended, real semantics
#   openai : text-embedding-3-small, set EMBEDDING_DIM to match
#   bedrock: amazon.titan-embed-text-v2:0, 1024 dims
#   local  : deterministic hashing embedder, no model needed (lexical only)
#
# EMBEDDING_DIM must match the model's native output width.
#   nomic-embed-text 768 | mxbai-embed-large 1024 | all-minilm 384
#   text-embedding-3-small 1536 (reducible) | titan-v2 1024
#
# CHANGING THE PROVIDER OR DIMENSION INVALIDATES STORED VECTORS.
# Run:  python scripts/reembed_memories.py
# ============================================================================
EMBEDDING_PROVIDER=ollama
EMBEDDING_DIM=768

MEMORY_TOP_K=6
# Cosine floor for semantic recall. Model dependent — measure your own:
#   nomic-embed-text  ~0.45  (it scores ~0.33 even for unrelated text)
#   local hashing     ~0.25
MEMORY_MIN_SIMILARITY=0.45
MEMORY_MAX_PER_AGENT=300

# ---- Short-term memory (conversation replay) -------------------------------
# Prompt evaluation dominates latency on CPU-only hardware (~16 tok/s in versus
# ~5 tok/s out for llama3.2:3b here), and replayed history is usually the
# largest part of the prompt. These cap the SIZE of the window, not just the
# message count: without them two long code-heavy answers turn a 2-character
# message into a 2000-token prompt (~130s before the first token).
SHORT_TERM_WINDOW=12
SHORT_TERM_MAX_CHARS=3000
SHORT_TERM_MESSAGE_MAX_CHARS=900
# Greetings ("hi", "thanks") get a minimal window, a compact system prompt and a
# small reply budget — a greeting needs no profile, memories or topic history.
SHORT_TERM_TRIVIAL_MAX_CHARS=700
TRIVIAL_REPLY_MAX_TOKENS=160
# Standing preferences ("always keep posts short") are pinned into every
# request for their agent, regardless of topical similarity.
MEMORY_STANDING_LIMIT=4
MEMORY_STANDING_IMPORTANCE=0.6

# --------------------------------------------------------- personalization
# How many times a feedback signal must repeat before it rewrites the profile.
FEEDBACK_PROMOTION_THRESHOLD=2
MEMORY_DEDUPE_SIMILARITY=0.92

# ============================================================================
# SCOPE GUARD — keeps each agent inside the one job it exists to do
# Every prompt carries a scope contract, but a 3B model does not reliably obey
# negative instructions, so this deterministic check backs it up: if the selected
# agent has essentially no signal for the request AND another agent clearly owns
# it, the reply is a handoff naming that agent — with no model call spent.
#
# It only runs when the user EXPLICITLY picked the agent (a routed request is in
# scope by construction) and is deliberately conservative: a wrong handoff is
# more annoying than a slightly off-topic answer. All four must hold.
#
# Raise the thresholds to hand off less often; set SCOPE_OTHER_MIN_SCORE very
# high to disable handoffs and rely on the prompt contract alone.
# ============================================================================
# Shorter requests ("hi", "thanks", "ok") are never handed off.
SCOPE_MIN_REQUEST_CHARS=15
# The selected agent must score at or below this to be considered unrelated.
SCOPE_OWN_MAX_SCORE=1.5
# Another agent must score at least this to be considered the owner.
SCOPE_OTHER_MIN_SCORE=4.0
# …and must beat the selected agent by at least this margin.
SCOPE_MIN_MARGIN=3.0

# ---------------------------------------------------------- cost / latency
# Each of these adds an extra model call per message.
# Two-stage LLM classification (first the domain, then the agent inside it) when
# no agent was explicitly selected. One 34-way choice is unreliable from a small
# model; two small choices are not.
ROUTER_USE_LLM=true
# Keyword score a single agent must reach to skip the model entirely.
ROUTER_KEYWORD_MIN_SCORE=4.0
# …and the margin it must hold over the runner-up. Set both to 0 to always ask
# the LLM (slower, one extra round trip per message).
ROUTER_LLM_MIN_MARGIN=3.0
# LLM-assisted memory extraction on top of the rule-based extractor. Off by
# default: it costs a second model call per user message.
MEMORY_LLM_EXTRACTION=false
